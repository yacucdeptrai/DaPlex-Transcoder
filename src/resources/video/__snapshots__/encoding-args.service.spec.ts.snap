exports[`EncodingArgsService (characterization) createAudioEncodingArgs AAC 5.1 downmix to stereo 1`] = `
[
  "-hide_banner",
  "-y",
  "-progress",
  "pipe:1",
  "-loglevel",
  "error",
  "-i",
  ""/transcode/42/source.mkv"",
  "-vn",
  "-c:a",
  "libfdk_aac",
  "-af",
  ""lowpass=c=LFE:f=120,pan=stereo|FL=.3FL+.21FC+.3FLC+.21SL+.21BL+.15BC+.21LFE|FR=.3FR+.21FC+.3FRC+.21SR+.21BR+.15BC+.21LFE,volume=1.6"",
  "-map",
  "0:1",
  "-map_chapters",
  "-1",
  "-f",
  "mp4",
  ""/transcode/42/audio_aac.mp4"",
]
`;

