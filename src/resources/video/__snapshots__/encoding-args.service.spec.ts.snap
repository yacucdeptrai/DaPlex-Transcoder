  "-hide_banner",
  "-y",
  "-hwaccel",
  "auto",
  "-progress",
  "pipe:1",
  "-loglevel",
  "error",
  "-i",
  ""/transcode/42/source.mkv"",
  "-c:v",
  "libvpx-vp9",
  "-g",
  "48",
  "-keyint_min",
  "48",
  "-sc_threshold",
  "0",
  "-crf",
  "30",
  "-maxrate",
  "8000K",
  "-bufsize",
  "16000K",
  "-svtav1-params",
  ""tune=0:enable-overlays=1:film-grain=0:film-grain-denoise=0:scd=1:sharpness=0:enable-qm=1:qm-min=0:enable-variance-boost=1:luminance-qp-bias=30:keyint=48"",
  "-map",
  "0:v:0",
  "-map_chapters",
  "-1",
  "-vf",
  "scale=-2:1080",
  ""/transcode/42/v_1080.webm"",
]
`;

